# Avatares subidos por los usuarios: la carpeta se versiona (.gitkeep) pero
# no su contenido, para que exista en cualquier clon/deploy sin arrastrar
# imágenes de usuarios reales.
/public/uploads/avatars/*
!/public/uploads/avatars/.gitkeep
